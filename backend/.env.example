# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=task_management

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Weather (OpenWeatherMap - free tier at openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key

# Email (Gmail App Password, or swap for Resend/SendGrid in utils/emailService.js)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Task Manager <youraddress@gmail.com>"

# File uploads are stored locally in /backend/uploads by default (no Cloudinary needed).
# Frontend needs to know the backend base URL to build file links:
BACKEND_PUBLIC_URL=http://localhost:5000
