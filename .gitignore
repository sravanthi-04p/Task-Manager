# Dependencies (huge, auto-installed via npm install — never commit these)
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables (contains your real DB password, JWT secret, API keys)
.env
backend/.env
frontend/.env

# Uploaded file attachments (user-generated, not code — keep the folder via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Build output
dist/
frontend/dist/

# Logs & OS junk
*.log
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/
